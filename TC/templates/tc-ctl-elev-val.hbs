{{#if originalValue}}
<tr class="tc-ctl-elev-pair-elev-orig">
    <th><span>[[ele]]<span> </span>([[original]])</span></th>
    <td>{{originalValue}} m</td>
</tr>
{{/if}}
{{#if elevationValue}}
<tr class="tc-ctl-elev-pair-elev">
    <th><span>{{#if originalValue}}[[ele]]<span> </span>([[mdt]]){{else}}[[elevation.explained]]{{/if}}</span></th>
    <td>{{elevationValue}} m</td>
</tr>
{{/if}}
{{#if heightValue}}
<tr class="tc-ctl-elev-pair-height">
    <th><span>[[heightOverTerrain]]</span></th>
    <td>{{heightValue}} m</td>
</tr>
{{/if}}
