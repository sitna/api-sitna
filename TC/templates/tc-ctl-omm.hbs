<h2>[[offlineMaps]]</h2>
<div class="tc-ctl-omm-content">
    <div class="tc-ctl-omm-draw tc-hidden"></div>
    <i class="tc-ctl-omm-map-search-icon"></i>
    <input type="search" list="{{listId}}" class="tc-ctl-omm-map-available-srch tc-textbox" placeholder="[[cb.filter.plhr]]"{{#unless storedMaps}} disabled{{/unless}} maxlength="200" />                
    <ul id="{{listId}}" class="tc-ctl-omm-list">
        <li class="tc-ctl-omm-map-available-empty"{{#if storedMaps}} hidden{{/if}}><span>[[cb.noMaps]]</span></li>
        <li class="tc-ctl-omm-map-not" hidden><span>[[noMatches]]</span></li>
        {{#each storedMaps}}
        {{> tc-ctl-omm-map-node }}
        {{/each}}
    </ul>
    <div class="tc-ctl-omm-new">
        <sitna-button class="tc-ctl-omm-btn-new" disabled title="[[newOfflineMap]]" aria-label="[[newOfflineMap]]">[[newOfflineMap]]</sitna-button>
    </div>
    <div class="tc-ctl-omm-drawing tc-hidden">
        <div class="tc-ctl-omm-tile-cmd">
            <sitna-button class="tc-ctl-omm-btn-cancel-draw" title="[[cancel]]" aria-label="[[cancel]]">[[cancel]]</sitna-button>
        </div>
    </div>
    <div class="tc-ctl-omm-progress tc-hidden">
        <p>[[cb.DownloadingMap]]: <span class="tc-ctl-omm-progress-count"></span></p>
        <div class="tc-ctl-omm-progress-bar">
            <div class="tc-ctl-omm-progress-ratio" style="width:0"></div>
        </div>
        <sitna-button class="tc-ctl-omm-btn-cancel-dl" title="[[cancel]]" aria-label="[[cancel]]">[[cancel]]</sitna-button>
    </div>
</div>
