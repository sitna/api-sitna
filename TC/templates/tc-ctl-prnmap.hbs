<h2>[[print]]</h2>
<div>
    <div class="tc-ctl-prnmap-div">
        <div class="tc-group tc-ctl-prnmap-cnt">
            <label>[[title]]:</label><input type="text" class="tc-ctl-prnmap-title tc-textbox" maxlength="30" placeholder="[[mapTitle]]" />
        </div>
        <div class="tc-group tc-ctl-prnmap-cnt">
            <label>[[layout]]:</label><select id="print-design" class="tc-combo" title="[[layoutTitle]]">
                <option value="landscape">[[landscape]]</option>
                <option value="portrait">[[portrait]]</option>
            </select>
        </div>
        <div class="tc-group tc-ctl-prnmap-cnt">
            <label>[[size]]:</label><select id="print-size" class="tc-combo"  title="[[sizeTitle]]">
                <option value="a4">A4</option>
                <option value="a3">A3</option>
            </select>
        </div>
        <div class="tc-group tc-ctl-prnmap-cnt tc-ctl-prnmap-cnt-btn">
            <sitna-toggle class="tc-ctl-prnmap-image-qr" title="[[createQrCodeToImage]]" checked>[[appendQRCode]]</sitna-toggle>
            <sitna-button class="tc-ctl-prnmap-btn" title="[[printMap]]">[[print]]</sitna-button>
        </div>
        <div class="tc-group tc-ctl-prnmap-cnt">
            <div class="tc-ctl-prnmap-alert tc-alert tc-alert-warning tc-hidden">
                <p>[[qrAdvice]]</p>
            </div>
        </div>
    </div>
</div>