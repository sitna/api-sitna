<li data-id="{{id}}" data-uid="{{uid}}">
    <div class="tc-ctl-geolocation-tools-always">
        <sitna-button variant="link" text="{{name}}"></sitna-button>
        <input class="tc-textbox tc-hidden" type="text" value="{{name}}" />

        <sitna-button variant="minimal" class="tc-btn-save tc-hidden">[[save]]</sitna-button>
        <sitna-button variant="minimal" class="tc-btn-cancel tc-hidden">[[tr.lst.cancel]]</sitna-button>
        <sitna-button variant="minimal" class="tc-btn-edit">[[tr.lst.edit]]</sitna-button>
        <sitna-button variant="minimal" class="tc-btn-share">[[tr.lst.share]]</sitna-button>
        <sitna-button variant="minimal" class="tc-btn-export">[[tr.lst.download]]</sitna-button>
        <sitna-button variant="minimal" class="tc-btn-delete">[[tr.lst.delete]]</sitna-button>
    </div>
    <div class="tc-ctl-geolocation-tools-active">
        <div class="tc-ctl-geolocation-tools-sim">
            <sitna-button variant="minimal" class="tc-btn-stop">[[tr.lst.stop]]</sitna-button>
            <sitna-button variant="minimal" class="tc-btn-pause tc-play">[[tr.lst.start]]</sitna-button>
            <sitna-button variant="minimal" class="tc-btn-backward">[[tr.lst.backward]]</sitna-button>
            <label class="tc-spn-speed" title="[[tr.lst.velocity]]"></label>
            <sitna-button variant="minimal" class="tc-btn-forward">[[tr.lst.forward]]</sitna-button>
        </div>
        <sitna-toggle class="tc-chk-track-visibility" checked title="[[tr.lst.view]]" checked-icon-text="&#xe910;" unchecked-icon-text="&#xe911;"></sitna-toggle>
    </div>
</li>
