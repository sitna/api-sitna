<div class="tc-ctl-wfsquery-dialog tc-modal">
    <div class="tc-modal-background tc-modal-close"></div>
    <div class="tc-modal-window tc-ctl-wfsquery-modal-window" >
        <div class="tc-modal-header">
            <h3>[[headerTitle]]</h3>
            <div title="[[query.tooltipCloseDialogBtn]]" class="tc-modal-close" ></div>
        </div>
        <div class="tc-modal-body">
            
            {{#if (gt layers.length 1)}}                      
                <div>
                    <select class="tc-combo" title="[[query.chooseALayerCombo]]" name="availableLayers">
                        <option value="">[[query.chooseALayerCombo]]</option>
                        {{#each layers}}
                        <option value="{{name}}">{{title}}</option>
                        {{/each}}
                    </select>
                </div>            
            {{/if}}
                <div class="tc-modal-form">
                </div>
                <div class="tc-ctl-wfsquery-message tc-hidden"></div>                 
            </div>
        <div class="tc-modal-footer">
            <sitna-button title="[[query.tooltipSendQueryBtn]]" class="tc-ctl-wfsquery-btn-launch">[[query.sendQueryBtnText]]</sitna-button>
            <sitna-button title="[[query.cancelQueryTooltip]]" class="tc-modal-close">[[query.cancelQueryButton]]</sitna-button>
        </div>
    </div>
</div>