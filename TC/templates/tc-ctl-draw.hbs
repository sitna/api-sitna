<div class="tc-ctl-draw-tools">
    <sitna-button variant="textless" class="tc-ctl-draw-btn-new" title="[[tooltip]]">[[new]]</sitna-button>
    <sitna-button variant="textless" class="tc-ctl-draw-btn-undo" disabled title="[[undo]]">[[undo]]</sitna-button>
    <sitna-button variant="textless" class="tc-ctl-draw-btn-redo" disabled title="[[redo]]">[[redo]]</sitna-button>
    <sitna-button variant="textless" class="tc-ctl-draw-btn-end" disabled title="[[end]]">[[end]]</sitna-button>
    <sitna-button variant="textless" class="tc-ctl-draw-btn-cancel" title="[[cancel]]">[[cancel]]</sitna-button>
</div>
<div class="tc-ctl-draw-style{{#unless stylable}} tc-hidden{{/unless}}">
    <sitna-feature-styler></sitna-feature-styler>
</div>

