<h2>[[backgroundMaps]] <sitna-toggle variant="switch" checked checked-icon-text="&#xe913;" unchecked-icon-text="&#xe914;" class="tc-ctl-bms-btn-view" title="[[showDetailsView]]"></sitna-toggle></h2>
<div class="tc-ctl-bms-tree tc-grid">
    <ul class="tc-ctl-bms-branch">
        {{#each baseLayers}}
        {{> tc-ctl-bms-node controlId=../controlId isDialog=../isDialog }}
        {{/each}}
        {{#if dialogMore}}
        <li class="tc-ctl-bms-node">
            <label class="tc-ctl-bms-more-node" title="[[moreBackgroundMaps]]"><input type="radio" name="{{controlId}}-bm" value="moreLayers"><span></span></label>
            <div class="tc-ctl-bms-info">
                <h3>[[moreBackgroundMaps]]</h3>
            </div>
        </li>
        {{/if}}
    </ul>
</div>