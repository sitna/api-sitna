<<div class="tc-ctl-popup">
    <div class="tc-ctl-popup-content{{#if closeButton}} tc-ctl-popup-has-btn{{/if}}"></div>
    <div class="tc-ctl-popup-menu">
        {{#if closeButton}}
        <sitna-button variant="minimal" class="tc-ctl-popup-close">[[close]]</sitna-button>
        {{/if}}
        {{#if shareButton}}
        <sitna-button variant="minimal" class="tc-ctl-popup-share">[[shareQuery]]</sitna-button>
        {{/if}}
    </div>
</div>