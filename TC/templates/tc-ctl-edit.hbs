<h2>[[featureEditing]]</h2>
<div class="tc-ctl-edit-tools">
    <div class="tc-ctl-edit-mode">
        <sitna-tab class="tc-ctl-edit-btn-modify" title="[[select]]" group="{{controlId}}-mode" for="{{controlId}}-mode-modify"></sitna-tab>
        <sitna-tab class="tc-ctl-edit-btn-point"  title="[[newPoint]]" group="{{controlId}}-mode" for="{{controlId}}-mode-addpoint"></sitna-tab>
        <sitna-tab class="tc-ctl-edit-btn-line" title="[[newLine]]" group="{{controlId}}-mode" for="{{controlId}}-mode-addline"></sitna-tab>
        <sitna-tab class="tc-ctl-edit-btn-polygon" title="[[newPolygon]]" group="{{controlId}}-mode" for="{{controlId}}-mode-addpolygon"></sitna-tab>
        {{#if otherToolsIncluded}}<sitna-tab class="tc-ctl-edit-btn-other" title="[[otherTools]]" group="{{controlId}}-mode" for="{{controlId}}-mode-other"></sitna-tab>{{/if}}
    </div>
    <div id="{{controlId}}-mode-modify" class="tc-ctl-edit-modify tc-hidden">
        <sitna-modify {{#if snapping}} snapping{{/if}}{{#if stylable}} stylable{{/if}}></sitna-modify>
        <sitna-attributes-edit></sitna-attributes-edit>
    </div>
    <div id="{{controlId}}-mode-addpoint" class="tc-ctl-edit-point tc-hidden">
        <sitna-draw mode="point" measurer borrowed-layer{{#if stylable}} stylable{{/if}}></sitna-draw>
        <sitna-attributes-edit></sitna-attributes-edit>
    </div>
    <div id="{{controlId}}-mode-addline" class="tc-ctl-edit-line tc-hidden">
        <sitna-draw mode="polyline" measurer borrowed-layer{{#if stylable}} stylable{{/if}}></sitna-draw>
        <sitna-attributes-edit></sitna-attributes-edit>
    </div>
    <div id="{{controlId}}-mode-addpolygon" class="tc-ctl-edit-polygon tc-hidden">
        <sitna-draw mode="polygon" measurer borrowed-layer{{#if stylable}} stylable{{/if}}></sitna-draw>
        <sitna-attributes-edit></sitna-attributes-edit>
    </div>
    <div id="{{controlId}}-mode-other" class="tc-ctl-edit-other tc-hidden">
        <sitna-button class="tc-ctl-edit-btn-import" aria-label="[[importFromOtherLayer]]">[[importFromOtherLayer]]</sitna-button>
        <sitna-button class="tc-ctl-edit-btn-dl" aria-label="[[download]]">[[download]]</sitna-button>
    </div>
    <sitna-measurement></sitna-measurement>
</div>