<div class="tc-ctl-omm-dialog tc-modal">
    <div class="tc-modal-background tc-modal-close"></div>
    <div class="tc-modal-window">
        <div class="tc-modal-header">
            <h3>[[newOfflineMap]]</h3>
            <div class="tc-modal-close" title="[[close]]"></div>
        </div>
        <div class="tc-modal-body">
            <input type="text" class="tc-ctl-omm-txt-name" placeholder="[[nameRequired]]" required />
            <div class="tc-ctl-omm-bl-panel">
                <h4>[[availableOfflineMaps]]</h4>
                <p class="tc-ctl-omm-bl-panel-txt">[[selectAtLeastOne]]</p>
                <ul class="tc-ctl-omm-bl-list"></ul>
            </div>
            <div class="tc-ctl-omm-3d-panel">
                <sitna-toggle class="tc-ctl-omm-3d">[[3dViewNotIncluded]]</sitna-toggle>
            </div>
            <div class="tc-ctl-omm-res-panel tc-hidden">
                <h4>[[maxRes]]</h4>
                <div class="tc-ctl-omm-res"></div>
                <input type="range" class="tc-ctl-omm-rng-maxres" disabled value="0" title="[[maxRes]]">
            </div>
            <div class="tc-ctl-omm-tile-count tc-hidden"></div>
        </div>
        <div class="tc-modal-footer">
            <sitna-button class="tc-modal-close tc-ctl-omm-btn-ok" aria-label="[[ok]]" disabled>[[ok]]</sitna-button>
            <sitna-button class="tc-modal-close tc-ctl-omm-btn-cancel" aria-label="[[cancel]]">[[cancel]]</sitna-button>
        </div>
    </div>
</div>
