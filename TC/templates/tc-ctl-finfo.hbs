<div class="tc-ctl-finfo-coords">
    <span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-coords-crs" title="[[crs]]">CRS: <span class="tc-ctl-finfo-coords-val">{{crs}}</span></span>
    {{#if isGeo}}
    <span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-coords-lat">[[lat]]: <span class="tc-ctl-finfo-coords-val">{{coords.[1]}}</span></span>
    <span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-coords-lon">[[lon]]: <span class="tc-ctl-finfo-coords-val">{{coords.[0]}}</span></span>
    {{else}}
    <span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-coords-x">x: <span class="tc-ctl-finfo-coords-val">{{coords.[0]}}</span></span>
    <span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-coords-x">y: <span class="tc-ctl-finfo-coords-val">{{coords.[1]}}</span></span>
    {{/if}}
    {{#if displayElevation}}<span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-elev" title="[[feature]]">[[ele]]: <span class="tc-ctl-finfo-coords-val"></span></span><span class="tc-ctl-finfo-coords-pair tc-ctl-finfo-height" title="[[heightOverTerrain]]">[[height]]: <span class="tc-ctl-finfo-coords-val"></span></span>{{/if}}
</div>
<div class="tc-ctl-finfo-result {{#if featureCount}}{{#if (gt featureCount 1)}} tc-ctl-finfo-multilayer{{/if}} {{/if}}">
    <ul class="tc-ctl-finfo-services">
    {{#each services}}
        <li data-url="{{url}}">
            <h3 class="tc-loading">
                <span title="{{#if title}}{{{title}}}{{else}}{{#if layers.[0].title}}{{{layers.[0].title}}}{{else}}{{layer.name}}{{/if}}{{/if}}">
                    {{#if title}}{{{title}}}{{else}}{{#if layers.[0].title}}{{{layers.[0].title}}}{{else}}{{layer.name}}{{/if}}{{/if}}
                </span>
            </h3>
        </li>
        {{else}}
        {{#if displayElevation}}
            {{#unless loading}}
                {{#unless displayElevation}}<li class="tc-ctl-finfo-empty">[[noData]]</li>{{/unless}}
            {{/unless}}
        {{/if}}
    {{/each}}
    </ul>
</div>
<div class="tc-ctl-finfo-counter{{#unless featureCount}}{{#unless (gt featureCount 1)}} tc-hidden{{/unless}} {{/unless}}">
    <button type="button" class="tc-ctl-btn tc-ctl-finfo-btn-prev">[[previous]]</button>
    <div class="tc-ctl-finfo-counter-pages"><span class="tc-ctl-finfo-counter-current"></span>/{{featureCount}}</div>
    <button type="button" class="tc-ctl-btn tc-ctl-finfo-btn-next">[[next]]</button>
</div>
