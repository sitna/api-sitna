<div class="tc-ctl-dldlog tc-modal {{cssClass}}">
    <div class="tc-modal-background tc-modal-close"></div>
    <div class="tc-modal-window">
        <div class="tc-modal-header">
            <h3>{{title}}</h3>
            <div class="tc-modal-close"  title="{{i18n "close"}}"></div>
        </div>
        <div class="tc-modal-body">
            {{#if elevation}}
            <div class="tc-ctl-dldlog-elev">
                <sitna-toggle {{#if elevation.checked}}checked{{/if}}>{{i18n "includeElevations"}}</sitna-toggle>
                <div class="tc-ctl-dldlog-elev-ipt">
                    <div class="tc-ctl-dldlog-elev-src">
                        <label>
                            <input type="radio" name="{{controlId}}-dldlog-source" value="track" checked />
                            <span>{{i18n "keepFromGeometry"}}</span>
                        </label>
                        <label>
                            <input type="radio" name="{{controlId}}-dldlog-source" value="mdt" />
                            <span title="{{i18n "getFromDtm.title"}}">{{i18n "getFromDtm"}}</span>
                        </label>
                    </div>
                {{#if elevation.resolution}}
                    <div class="tc-ctl-dldlog-elev-ip">
                        <h4>{{i18n "interpolateCoordsFromElevProfile"}}</h4>
                        <label>
                            <input type="radio" name="{{uid}}-finfo-ip-coords" value="0" checked />
                            <span>{{i18n "no"}}</span>
                        </label>
                        <label>
                            <input type="radio" name="{{uid}}-finfo-ip-coords" value="1" />
                            <span>{{i18n "yes"}}</span>
                        </label>
                        <div class="tc-ctl-dldlog-elev-ip-m tc-hidden">{{i18n "interpolateEveryXMeters.1"}}<input type="number" min="1" step="1" class="tc-textbox" value="{{elevation.resolution}}" />{{i18n "interpolateEveryXMeters.2"}}</div>
                    </div>
                {{/if}}
                </div>
            </div>
            {{/if}}
            <div class="tc-ctl-dldlog-dl">
                <div>
                    {{#each formats}}
                    {{#if (eq this "KML")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-kml" data-format="KML" title="KML">KML</sitna-button>
                    {{~else if (eq this "KMZ")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-kmz" data-format="KMZ" title="KML">KML</sitna-button>
                    {{~else if (eq this "GML")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-gml" data-format="GML" title="GML">GML</sitna-button>
                    {{~else if (eq this "GeoJSON")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-geojson" data-format="GeoJSON" title="GeoJSON">GeoJSON</sitna-button>
                    {{~else if (eq this "WKT")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-wkt" data-format="WKT" title="WKT">WKT</sitna-button>
                    {{~else if (eq this "WKB")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-wkb" data-format="WKB" title="WKB">WKB</sitna-button>
                    {{~else if (eq this "GPX")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-gpx" data-format="GPX" title="GPX">GPX</sitna-button>
                    {{~else if (eq this "SHP")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-shp" data-format="SHP" title="Shapefile">Shapefile</sitna-button>
                    {{~else if (eq this "GPKG")~}}
                    <sitna-button class="tc-btn-dl tc-ctl-dldlog-btn-gpkg" data-format="GPKG" title="GeoPackage">GeoPackage</sitna-button>
                    {{~/if}}
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>