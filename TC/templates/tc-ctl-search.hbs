<h2>[[search1]]</h2>
<div class="tc-ctl-search-content">
    <div class="tc-ctl-search-box">
        <input type="search" class="tc-ctl-search-txt" placeholder="[[searchPlaceholder]]" title="[[searchInstructions]]" tabindex="0">
        <sitna-button variant="minimal" title="[[share]]" class="tc-ctl-search-share-btn tc-hidden">[[share]]</sitna-button>
        <sitna-button variant="minimal" title="[[searchInstructions]]" class="tc-ctl-search-btn" tabindex="-1">[[search2]]</sitna-button>
    </div>
</div>
<dialog class="tc-ctl-search-share-dialog" closedby="any">
    <div class="tc-modal-header">
        <h3>[[dialogHeader]]</h3>
        <sitna-button variant="minimal" class="tc-modal-close" title="[[close]]">[[close]]</sitna-button>
    </div>
    <div class="tc-modal-body">
        <div class="tc-ctl-search-share-dialog-ctl"></div>
    </div>
</dialog>


