{{#*inline "inputNumber"}}
<input type="number" class="tc-textbox" name="{{name}}" value="{{value}}" inputmode="decimal" />
{{/inline}}
{{#*inline "inputInteger"}}
<input type="number" class="tc-textbox" name="{{name}}" value="{{value}}" inputmode="numeric" />
{{/inline}}
{{#if attributeProposal}}
<tr data-attribute-name="{{attributeProposal}}" class="tc-ctl-attr-edit-proposal">
    <th>{{attributeProposal}}</th>
    <td>
        <select class="tc-combo tc-ctl-attr-edit-type tc-active" title="{{attributeProposal}}" data-attribute-name="{{attributeProposal}}">
            <option value="">[[selectDataType]]</option>
            <option value="string">[[text]]</option>
            <option value="float">[[number]]</option>
            <option value="integer">[[integer]]</option>
            <option value="boolean">[[boolean]]</option>
            <option value="date">[[date]]</option>
            <option value="time">[[time]]</option>
            <option value="datetime">[[datetime]]</option>
        </select>
    </td>
    <td><sitna-button variant="minimal" class="tc-ctl-attr-edit-remove" data-key="{{attributeProposal}}">[[removeAttribute]]</sitna-button></td>
</tr>
{{else}}
<tr class="tc-ctl-attr-edit-new">
    <th colspan="3"><input type="text" placeholder="[[addNewAttribute]]" class="tc-textbox tc-ctl-attr-edit-new-key" /></th>
</tr>
{{/if}}
