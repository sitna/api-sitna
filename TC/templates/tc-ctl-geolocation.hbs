<h2>[[geo]]</h2>
<div class="tc-ctl-geolocation-content">    
    <div class="tc-ctl-geolocation-track">
        <div class="tc-ctl-geolocation-track-snap-info"></div>                
        <div class="tc-ctl-geolocation-track-panel-block">
            <sitna-toggle title="[[geo.trk.panel.help.1]]" checked>[[geo.trk.panel.help.2]]</sitna-toggle>
            <sitna-button variant="minimal" icon="help" text="[[geo.trk.panel.help.3]]" class="tc-ctl-geolocation-track-panel-help"></sitna-button>
        </div>
        <div class="tc-ctl-geolocation-track-mng">
            <div class="tc-ctl-geolocation-select">
                <sitna-tab text="[[geo.gps]]" title="[[geo.track.title]]" group="{{controlId}}-mode" selected for="{{controlId}}-geolocation-panel"></sitna-tab>
                <sitna-tab text="[[geo.tracks]]" title="[[geo.tracks.title]]" group="{{controlId}}-mode" for="{{controlId}}-tracks-panel"></sitna-tab>
            </div>                        
            <div id="{{controlId}}-tracks-panel" class="tc-ctl-geolocation-track-available tc-ctl-geolocation-track-cnt tc-ctl-geolocation-panel tc-hidden">
                <i class="tc-ctl-geolocation-track-search-icon"></i>
                <input id="tc-ctl-geolocation-track-available-srch" type="search" list="tc-ctl-geolocation-track-available-lst" class="tc-ctl-geolocation-track-available-srch tc-textbox" placeholder="[[geo.filter.plhr]]" maxlength="200" />                
                <ol class="tc-list tc-ctl-geolocation-track-available-lst">
                    <li class="tc-ctl-geolocation-track-available-empty"><span>[[geo.noTracks]]</span></li>
                    <li class="tc-ctl-geolocation-track-not" hidden><span>[[noMatches]]</span></li>
                </ol>
                <div class="tc-ctl-geolocation-track-cnt">
                    <sitna-button class="tc-btn-delete-all" disabled title="[[geo.trk.delete.all.tooltip]]">[[geo.trk.delete.all]]</sitna-button>
                    <input name="uploaded-file" id="uploaded-file-{{controlId}}" type="file" class="tc-ctl-geolocation-track-import tc-button" accept=".gpx,.kml,.kmz" disabled />
                    <label class="tc-button tc-icon-button" for="uploaded-file-{{controlId}}" title="[[geo.trk.import.upload]]">[[geo.trk.import.lbl]]</label>
                </div>
            </div>
            <div id="{{controlId}}-geolocation-panel" class="tc-ctl-geolocation-tracks tc-ctl-geolocation-panel">    
                <div class="tc-alert tc-alert-warning tc-hidden" >
                    <p id="panel-msg">
                        [[geo.trk.panel.1]]                    
                        <ul>
                            <li>[[geo.trk.panel.2]]</li>
                            <li>[[geo.trk.panel.3]]</li>
                            <li>[[geo.trk.panel.4]]</li>
                            <li>[[geo.trk.panel.5]]</li>
                        </ul>
                    </p>
                </div>            
                <div class="tc-ctl-geolocation-track-ui">   
                    <div  class="tc-ctl-geolocation-track-render">
                        <sitna-toggle title="[[geo.trk.render]]" checked>[[geo.trk.render]]</sitna-toggle>
                    </div>
                    <sitna-button class="tc-ctl-geolocation-track-ui-activate" title="[[geo.track.activate.title]]">[[geo.track.activate]]</sitna-button>
                    <sitna-button class="tc-ctl-geolocation-track-ui-deactivate tc-hidden" active title="[[geo.track.deactivate.title]]">[[geo.track.deactivate]]</sitna-button>
                </div>
                <div class="tc-ctl-geolocation-track-current tc-ctl-geolocation-track-cnt">
                    <div>
                        <input type="text" class="tc-ctl-geolocation-track-title tc-textbox" disabled placeholder="[[geo.trk.name.plhr]]" maxlength="200" /><sitna-button variant="textless" class="tc-ctl-geolocation-track-save" disabled>[[geo.trk.name.save]]</sitna-button>
                    </div>
                    <div>
                        <input type="text" class="tc-ctl-geolocation-track-waypoint tc-textbox" disabled placeholder="[[geo.trk.wyp.plhr]]" maxlength="200" /><sitna-button variant="textless" class="tc-ctl-geolocation-track-add-wpt" disabled>[[geo.trk.wyp.save]]</sitna-button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="tc-ctl-geolocation-track-center tc-hidden">
    <button type="button" class="tc-float-btn" title="[[geo.trk.center]]"></button>
</div>


