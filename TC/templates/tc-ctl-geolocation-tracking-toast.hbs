<table class="tc-ctl-geolocation-info-tracking">
    <tr>
        <th>{{#if isGeo}}[[lon]]{{else}}X{{/if}}:</th>
        <td> {{x}} </td>
        {{#if accuracy}}
        <th>[[geo.trk.accuracy]]:</th>
        <td> {{accuracy}} m </td>
        {{/if}}
    </tr>
    <tr>
        <th>{{#if isGeo}}[[lat]]{{else}}Y{{/if}}:</th>
        <td> {{y}} </td>
        {{#if speed}}
        <th>[[geo.trk.speed]]:</th>
        <td>{{speed}} km/h</td>
        {{/if}}
    </tr>
    <tr>
        {{#if z}}
        <th>{{#if isGeo}}[[ele]]{{else}}Z{{/if}}:</th>
        <td> {{z}} m </td>
        {{/if}}
        {{#if mdt}}
        <th title="[[mdt.title]]">[[ele]]<span> </span>([[mdt]]):</th>
        <td>{{mdt}} m </td>
        {{/if}}
    </tr>    
</table>
