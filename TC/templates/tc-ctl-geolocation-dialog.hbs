<div class="tc-ctl-geolocation-continue-track-dialog tc-modal" >
    <div class="tc-modal-background tc-modal-close"></div>
    <div class="tc-modal-window">
        <div class="tc-modal-header">
            <h3>[[geo.gps]]</h3>
            <div class="tc-modal-close" title="[[close]]"></div>
        </div>
        <div class="tc-modal-body">
            <sitna-button class="tc-ctl-geolocation-track-continue">[[geo.trk.dialog.cnt]]</sitna-button>
            <sitna-button class="tc-ctl-geolocation-track-new">[[geo.trk.dialog.new]]</sitna-button>
            <sitna-button class="tc-modal-close">[[geo.trk.dialog.cancel]]</sitna-button>
        </div>
    </div>
</div>
<div class="tc-ctl-geolocation-track-warning-dialog tc-modal" >
    <div class="tc-modal-background tc-modal-close"></div>
    <div class="tc-modal-window">
        <div class="tc-modal-header">
            <h3>[[geo.track.activate.title]]</h3>
            <div class="tc-modal-close" title="[[close]]"></div>
        </div>
        <div class="tc-modal-body">
            <p id="pageBlurMsg">[[geo.trk.page.blur]]</p>
            <p class="tc-ctl-geolocation-track-warning">
                <sitna-toggle name="checkbox">[[geo.trk.dialog.doNotShow]]</sitna-toggle>
            </p>
        </div>
        <div class="tc-modal-footer">
            <sitna-button class="tc-ctl-geolocation-track-warning-ok">[[ok]]</sitna-button>
        </div>
    </div>
</div>

