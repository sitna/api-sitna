<div class="tc-ctl-m-finfo-select">
    <span>[[selectionBy]]</span>
    {{#if pointSelectValue}}<label class="tc-ctl-m-finfo-btn-point" title="[[selectionByPoint]]"><input type="radio" name="{{controlId}}-mode" value="{{pointSelectValue}}" checked /><span class="tc-ctl-btn">[[byPoint]]</span></label>{{/if}}
    {{#if lineSelectValue}}<label class="tc-ctl-m-finfo-btn-line" title="[[selectionByLine]]"><input type="radio" name="{{controlId}}-mode" value="{{lineSelectValue}}" /><span class="tc-ctl-btn">[[byLine]]</span></label>{{/if}}
    {{#if polygonSelectValue}}<label class="tc-ctl-m-finfo-btn-polygon" title="[[selectionByPrecinct]]"><input type="radio" name="{{controlId}}-mode" value="{{polygonSelectValue}}" /><span class="tc-ctl-btn">[[byPrecinct]]</span></label>{{/if}}
    <sitna-button variant="minimal" class="tc-ctl-m-finfo-btn-zoom" disabled>[[zoomFeatures]]</sitna-button>
    <sitna-button variant="minimal" class="tc-ctl-m-finfo-btn-dl" icon="download-all" disabled text="[[downloadFeatures]]"></sitna-button>
    <sitna-button variant="minimal" class="tc-ctl-m-finfo-btn-remove" icon="delete" disabled text="[[deleteFeatures]]"></sitna-button>
    
</div>
