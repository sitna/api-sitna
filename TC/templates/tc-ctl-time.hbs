<h2>[[timeProgress]]</h2>
<div class="tc-ctl-time-body">
    <div class="tc-ctl-time-title"><sitna-button variant="minimal" class="tc-ctl-time-prev-btn"></sitna-button><span class="tc-ctl-time-cur"></span><sitna-button variant="minimal" class="tc-ctl-time-next-btn"></sitna-button></div>
    <input type="range" class="tc-ctl-time-rng" list="{{controlId}}-time-ticks" />
    <datalist id="{{controlId}}-time-ticks"></datalist>
    <div class="tc-ctl-time-axis"></div>
</div>
<div class="tc-ctl-time-warn">[[layerNotInTimeline]]</div>