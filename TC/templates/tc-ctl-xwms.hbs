{{#if title}}<h2>[[addMaps]]</h2>{{/if}}
<div>
    <div class="tc-group tc-ctl-xwms-cnt">        
        <select class="tc-combo" title="WMS (Web Map Service)">
            <option value="">WMS</option>
            {{#each suggestions}}
			    {{#if group}}
                <optgroup label="{{group}}">
			    {{/if}}
                {{#each items}}
                    <option value="{{url}}">{{name}}</option>
                {{/each}}
			    {{#if group}}	
                </optgroup>
			    {{/if}}
            {{/each}}
        </select>
        <input type="url" class="tc-textbox" placeholder="[[writeAddressOrSelect]]" />
    </div>


    <div class="tc-group tc-group tc-ctl-xwms-cnt" style="text-align:right;">
        <sitna-button title="[[addService.title]]" name="agregar">[[addService]]</sitna-button>
    </div>
</div>
