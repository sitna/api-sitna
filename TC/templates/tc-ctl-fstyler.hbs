<div class="tc-ctl-fstyler-stroke">
    [[strokeColor]]
    <input type="color" class="tc-ctl-col tc-ctl-fstyler-str-c" value="{{strokeColor}}" title="[[selectColor]]" />
    [[width]]
    <div class="tc-ctl-fstyler-str-w-watch" style="border-bottom-width:{{strokeWidth}}px;"> </div>
    <input type="number" class="tc-ctl-fstyler-str-w tc-textbox" value="{{strokeWidth}}" min="1" max="15" inputmode="numeric" />
</div>
<div class="tc-ctl-fstyler-fill">
    [[fillColor]]
    <input type="color" class="tc-ctl-col tc-ctl-fstyler-fll-c" value="{{fillColor}}" title="[[selectColor]]" />
    [[opacity]]
    <input type="number" class="tc-ctl-fstyler-fll-w tc-textbox" value="{{fillOpacity}}" min="0" max="100" inputmode="numeric" />
</div>
<div class="tc-ctl-fstyler-radius">
    [[symbolRadius]]
    <input type="number" class="tc-ctl-fstyler-rad-w tc-textbox" value="{{radius}}" min="1" max="100" inputmode="numeric" />
</div>
<div class="tc-ctl-fstyler-other">
    <sitna-button variant="minimal" class="tc-ctl-fstyler-btn-remove tc-hidden" title="[[putBackStyle]]">[[putBackStyle]]</sitna-button>
</div>
