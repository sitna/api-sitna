<div class="tc-track-chart">
    {{#if msg}}
    {{msg}}
    {{else}}
    {{#if secondChart}}
    <div class="tc-track-chart-elevation-minmax">
        <div class="tc-track-chart-minmax">
            <span>
                Min,Max:&nbsp;
            </span>
            <div>
                <span class="{{colorClass}}">
                    {{min}}, {{max}}
                </span>
                {{#each secondChart}}
                <span class="{{colorClass}}">
                    {{min}}, {{max}}&nbsp;
                </span>
                {{/each}}
            </div>
        </div>
        <div class="tc-track-chart-elev-gain">
            <span>
                [[geo.trk.chart.elevationGain]]:&nbsp;
            </span>
            <div>
                <span class="{{colorClass}}">
                    +{{uphill}} m, -{{downhill}} m
                </span>
                {{#each secondChart}}
                <span class="{{colorClass}}">
                    +{{uphill}} m, -{{downhill}} m
                </span>
                {{/each}}                
            </div>
        </div>
    </div>
        {{else}}
        <span class="tc-track-chart-elev-gain">
            [[geo.trk.chart.elevationGain]]: +{{uphill}} m, -{{downhill}} m
        </span>
        {{/if}}
        <div class="tc-chart"></div>
    {{/if}}
    <div class="tc-track-chart-warning tc-hidden">[[noElevationData]]</div>
</div>
