<h2>[[featureEditing]]</h2>
<div class="tc-ctl-wfsedit-layer">
    <select class="tc-combo tc-ctl-wfsedit-layer-sel" title="[[selectLayerToEdit]]" disabled>
        <option value="">[[selectLayerToEdit]]</option>
        {{#each layers}}
        <option value="{{id}}">{{title}}</option>
        {{/each}}
    </select>
</div>
<div class="tc-ctl-wfsedit-view tc-hidden">
    <table>
        <tbody>
            <tr>
                <th><img class="tc-ctl-wfsedit-view-watch" /></th>
                <td>[[featuresInEditedLayer]]</td>
            </tr>
            <tr>
                <th><img class="tc-ctl-wfsedit-view-original-watch" /></th>
                <td><sitna-toggle class="tc-ctl-wfsedit-view-original-cb" {{#if showOriginalFeatures}} checked{{/if}} checked-icon-text="&#xe910;" unchecked-icon-text="&#xe911;">[[featuresAsBeforeEditing]]</sitna-toggle></td>
            </tr>
            <tr>
                <th><input type="color" id="tc-ctl-wfsedit-view-clr-added-{{controlId}}" class="tc-clt-wfsedit-view-clr-added" /><label for="tc-ctl-wfsedit-view-clr-added-{{controlId}}" title="[[clickToChangeColor]]"><img class="tc-ctl-wfsedit-view-added-watch" /></label></th>
                <td><sitna-toggle class="tc-ctl-wfsedit-view-added-cb"{{#if highlightChanges}} checked{{/if}} checked-icon-text="&#xe910;" unchecked-icon-text="&#xe911;">[[unsyncedAdded]]</sitna-toggle></td>
            </tr>
            <tr>
                <th><input type="color" id="tc-ctl-wfsedit-view-clr-modified-{{controlId}}" class="tc-clt-wfsedit-view-clr-modified" /><label for="tc-ctl-wfsedit-view-clr-modified-{{controlId}}" title="[[clickToChangeColor]]"><img class="tc-ctl-wfsedit-view-modified-watch" /></label></th>
                <td><sitna-toggle class="tc-ctl-wfsedit-view-modified-cb"{{#if highlightChanges}} checked{{/if}} checked-icon-text="&#xe910;" unchecked-icon-text="&#xe911;">[[unsyncedModified]]</sitna-toggle></td>
            </tr>
            <tr>
                <th><input type="color" id="tc-ctl-wfsedit-view-clr-removed-{{controlId}}" class="tc-clt-wfsedit-view-clr-removed" /><label for="tc-ctl-wfsedit-view-clr-removed-{{controlId}}" title="[[clickToChangeColor]]"><img class="tc-ctl-wfsedit-view-removed-watch" /></label></th>
                <td><sitna-toggle class="tc-ctl-wfsedit-view-removed-cb"{{#if highlightChanges}} checked{{/if}} checked-icon-text="&#xe910;" unchecked-icon-text="&#xe911;">[[unsyncedRemoved]]</sitna-toggle></td>
            </tr>
        </tbody>
    </table>
    <sitna-button variant="minimal" class="tc-ctl-wfsedit-btn-crop tc-hidden" title="[[refreshLayerToCurrentExtent]]">[[refreshLayerToCurrentExtent]]</sitna-button>
</div>
<div class="tc-ctl-wfsedit-edit tc-hidden"></div>
<div class="tc-ctl-wfsedit-save">
    <sitna-button class="tc-ctl-wfsedit-btn-save" disabled title="[[syncChanges]]">[[syncChanges]]</sitna-button>
    <sitna-button class="tc-ctl-wfsedit-btn-discard" disabled title="[[discardChanges]]">[[discardChanges]]</sitna-button>
</div>
